# =============================================================================
# REFAL Basketball League — environment variables
# Copy to .env.local and fill in from your Supabase project settings.
# NEVER commit .env.local. The service-role key is server-only and must never
# reach the browser (spec §11.7 "Никогда не размещать секретные ключи ... в
# клиентском коде").
# =============================================================================

# Public (safe to expose to the browser) — Project URL + anon key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret. Used exclusively in server code (admin user creation,
# storage administration). Must NOT have the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Public base URL of the site (used to build consent links/QR codes).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
